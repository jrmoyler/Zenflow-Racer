{
  "name": "zenflow-racer",
  "version": "1.2.0",
  "private": true,
  "description": "ZenFlow Racer \u2014 browser and installable arcade racing",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node tests/game-regression.cjs",
    "test:release": "node tests/build-shell.cjs",
    "verify": "npm test && npm run build && npm run test:release && npm run test:runtime && npm run test:assets",
    "test:runtime": "node tests/reference-runtime.cjs",
    "blender:karts": "node tools/export-kart-rig.cjs && bash tools/render-karts-blender.sh",
    "test:assets": "node tests/playable-assets.cjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "animejs": "4.2.2",
    "three": "0.128.0"
  }
}
